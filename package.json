{
  "name": "digital-pigeon",
  "productName": "DigitalPigeon",
  "version": "1.0.0",
  "private": true,
  "description": "Local HTTP client with an immutable call history",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Robert Radzik",
    "email": "robertradzik@gmail.com"
  },
  "scripts": {
    "build": "vite build -c vite.renderer.config.mts && vite build -c vite.server.config.mts",
    "start": "npm run build && node dist/server/main.mjs",
    "dev": "vite build -c vite.server.config.mts && DP_DEV=1 node dist/server/main.mjs",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "mongodb": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "8.12.3",
    "zod": "^4.6.7"
  }
}
